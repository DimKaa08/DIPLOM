FROM node:20-alpine

WORKDIR /app

# Сначала только зависимости — Docker кэширует этот слой
# Пересборка будет быстрой если изменился только код, не package.json
COPY package.json package-lock.json* ./
RUN npm install

# Копируем исходный код
COPY . .

EXPOSE 5173

# --host 0.0.0.0 обязателен в Docker:
# без него Vite слушает только localhost внутри контейнера
# и порт 5173 недоступен снаружи
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
