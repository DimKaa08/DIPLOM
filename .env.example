# ── Redis (Celery брокер) ─────────────────────────────────────────────────────
# Разработка (локальный Redis)
REDIS_URL=redis://localhost:6379/0
# Продакшн через Docker Compose (redis — имя сервиса)
# REDIS_URL=redis://redis:6379/0
# Продакшн с паролем
# REDIS_URL=redis://:пароль@хост:6379/0

# ── База данных ───────────────────────────────────────────────────────────────
# SQLite для разработки (не менять)
DATABASE_URL=sqlite:///./music_app.db
# PostgreSQL для продакшна (раскомментируй)
# DATABASE_URL=postgresql://user:password@localhost:5432/music_app
